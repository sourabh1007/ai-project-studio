{
  "name": "@ai-project-studio/desktop",
  "version": "0.10.1",
  "private": true,
  "description": "Electron desktop shell for AI Project Studio.",
  "author": "sourabh1007",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "stage": "node scripts/stage-runtime.mjs",
    "pack:dir": "electron-builder --dir --config electron-builder.yml",
    "dist:win": "electron-builder --win --config electron-builder.yml --publish never",
    "dist:mac": "electron-builder --mac --config electron-builder.yml --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
